{
  "manifest_version": 3,
  "name": "Pinterest Comfort Themes",
  "version": "0.1.0",
  "description": "Temas Claro, Escuro (cinza cimento) e Sépia, otimizados para o Pinterest.",
  "key": "",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Pinterest Comfort Themes",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start",
      "js": [
        "src/settings.js",
        "src/content.js"
      ],
      "css": [
        "css/tokens.css",
        "css/generic.css",
        "css/pinterest.css"
      ]
    }
  ]
}
