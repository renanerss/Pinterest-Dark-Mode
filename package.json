{
  "name": "pinterest-comfort-themes",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "build": "node scripts/build.js",
    "build:test": "node scripts/build.js --test",
    "package": "node scripts/build.js",
    "test:e2e": "node scripts/build.js --test && node scripts/build.js && playwright test tests/e2e",
    "icons": "node scripts/make-icons.js",
    "store-assets": "node scripts/build.js --test && node scripts/store-assets.js",
    "release": "node scripts/build.js && node scripts/release.js",
    "og-image": "node scripts/og-image.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "adm-zip": "^0.6.1",
    "pngjs": "^7.0.0"
  }
}
